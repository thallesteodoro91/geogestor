{
  "name": "geogestor-desktop",
  "version": "1.1.0",
  "description": "GeoGestor - Gestao para Topografia (Desktop)",
  "main": "main.js",
  "author": "GeoGestor",
  "packageManager": "npm@11.13.0",
  "private": true,
  "dependencies": {},
  "build": {
    "appId": "com.geogestor.desktop",
    "productName": "GeoGestor",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "electronVersion": "35.7.5",
    "npmRebuild": false,
    "beforeBuild": "./before-build.cjs",
    "directories": {
      "buildResources": "build",
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../api/dist",
        "to": "api",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../../data/geogestor.db",
        "to": "data/geogestor.db"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "GeoGestor"
    }
  }
}
